# Copy this file to .env and fill in the blanks.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# LLM (required)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works. This lab was built against Azure AI
# Foundry, but plain OpenAI works too: set LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=https://<your-foundry>.services.ai.azure.com/openai/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Phase 3: LangSmith (optional, hosted)
# ---------------------------------------------------------------------------
# Set LANGSMITH_TRACING=true and every run is traced automatically.
# Leave blank to skip Phase 3 entirely.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-observability-lab

# ---------------------------------------------------------------------------
# Phase 4: Langfuse (optional, self-hosted)
# ---------------------------------------------------------------------------
# Get these from Settings -> API Keys after the Docker stack is up.
# Leave blank to skip Phase 4 entirely.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
